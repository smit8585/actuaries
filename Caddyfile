:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@static path /assets/*
	header @static Cache-Control "public, max-age=3600"
}
